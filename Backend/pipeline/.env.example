# =============================================================
# AI Video Inpainting — Environment Configuration (Optional)
# =============================================================
# All settings have sensible defaults. You only need this file
# if you want to override the defaults.
#
# Copy this file to .env:  copy .env.example .env
# =============================================================

# Ollama vision model for frame analysis (default: llava)
# Other options: llama3.2-vision, bakllava, moondream
OLLAMA_MODEL=llava

# Stable Video Diffusion model ID from HuggingFace
SVD_MODEL=stabilityai/stable-video-diffusion-img2vid-xt

# Number of frames to generate (more = longer video, more VRAM)
SVD_NUM_FRAMES=25

# Random seed for reproducible generation
SVD_SEED=42
